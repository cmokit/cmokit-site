{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmokit-site-edge",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-10-01",
  // The Worker runs in front of the site's own domains, cmokit.ai and www.cmokit.ai, whose DNS
  // records are proxied by Cloudflare and point at GitHub Pages. app.cmokit.ai is the hosted app's,
  // not this site's.
  "routes": [
    { "pattern": "cmokit.ai/*", "zone_name": "cmokit.ai" },
    { "pattern": "www.cmokit.ai/*", "zone_name": "cmokit.ai" }
  ],
  // The lifecycle Worker in lifecycle/, which sends leads their messages. Deployed first.
  "services": [{ "binding": "LIFECYCLE", "service": "cmokit-site-lifecycle" }],
  "observability": { "enabled": true }
}
