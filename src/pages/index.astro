---
// CMO Kit's home page and the closed beta's waitlist. The form and its script are the ones CMO
// Kit's account page at app.cmokit.ai gives for this brand: join, then place and referral link,
// then an Instagram code to comment on our Reels, which the hosted waitlist shows only once it offers it.
// The script also counts the page as a visit, once a browser session, with no cookie or identity. Keep the field
// names, the data attributes and the script as given, and style freely. Joins are taken only from
// pages on https://cmokit.ai. The weekly review is an illustration, and the page says so.
import Page from '../layouts/Page.astro';
---

<Page title="CMO Kit: take control of your content strategy">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Closed beta · For independent creators</p>
        <h1>Take control of your content strategy.</h1>
        <p class="lead">CMO Kit plans your posts around what you sell, measures which bookings and sales each one brought, then analyzes the results and recommends improvements. It all happens in one conversation with Claude, and nothing goes out without your yes.</p>

        <div id="join" class="hero__join">
          <div class="waitlist" data-cmokit-waitlist>
            <form class="waitlist__row" method="post" action="https://app.cmokit.ai/join/c0f559a8489d8735" data-cmokit-join>
              <input class="field" type="email" name="email" required placeholder="you@example.com" aria-label="Email" autocomplete="email">
              <input type="text" name="website" tabindex="-1" autocomplete="off" hidden>
              <button class="button button--primary" type="submit">Join the waitlist</button>
            </form>
            <div class="referral" data-cmokit-joined hidden>
              <p class="referral__place" data-cmokit-place role="status">You're on the list.</p>
              <p>Boost your place: share your referral link. Everyone who joins through it moves you up.</p>
              <div class="referral__copy">
                <a class="referral__link" data-cmokit-referral></a>
                <button class="button button--quiet button--small" type="button" data-copy="[data-cmokit-referral]">Copy link</button>
              </div>
            </div>
            <div class="referral" data-cmokit-instagram hidden>
              <p>Boost even more: comment this code on one of our Reels, then comment on more. Each Reel you comment on moves you up.</p>
              <div class="referral__copy">
                <strong class="referral__code" data-cmokit-code></strong>
                <button class="button button--quiet button--small" type="button" data-copy="[data-cmokit-code]">Copy code</button>
              </div>
              <p><a data-cmokit-account></a></p>
            </div>
          </div>
          <p class="waitlist__note">Joining sends you nothing. We'll let you know when your spot opens. Joining isn't beta access: read the <a href="/beta-terms/">closed beta terms</a> you'll accept then, and our <a href="/privacy/">privacy policy</a>.</p>
        </div>
      </div>

      <figure class="card note" aria-label="An example of a weekly review from CMO Kit">
        <div class="note__head">
          <span class="note__title">Your weekly review</span>
          <span class="note__tag">Example</span>
        </div>
        <div class="note__stat">
          <span class="note__figure">9 of 14</span>
          <span class="muted small">paid seats at Thursday's workshop came from one reel</span>
        </div>
        <p class="note__body">The two quote cards you posted brought no one.</p>
        <div>
          <p class="eyebrow">Recommended</p>
          <ul class="note__list">
            <li>Film one more moment like Thursday's and post it Tuesday.</li>
            <li>Skip the quote cards for now.</li>
            <li>Try the shorter event page against the current one.</li>
          </ul>
        </div>
        <div class="note__foot">
          <span>Waiting for your approval</span>
          <span class="note__pill" aria-hidden="true">Approve the plan</span>
        </div>
      </figure>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="start">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Getting started</p>
        <h2 id="start">Start with what you already have.</h2>
        <p class="lead">No blank page and no new dashboard to learn. You talk it through, and CMO Kit plans your content and measures the results.</p>
      </div>
      <ol class="steps">
        <li class="card">
          <h3>Bring your brand</h3>
          <p>Share your brand book, your site or your recent posts. CMO Kit drafts your brand strategy from them for you to correct. Starting from scratch? It asks a few questions instead.</p>
        </li>
        <li class="card">
          <h3>Name what you're selling</h3>
          <p>An event, a course, a session or a product. CMO Kit plans posts, ads and page tests backwards from it, and gives each one its own tracked link.</p>
        </li>
        <li class="card">
          <h3>Measure and analyze the results</h3>
          <p>It measures the registrations and sales each link brings on the pages where people buy, like Luma, Stripe or your shop. Then it analyzes the results and recommends improvements.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="charge">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">You stay in charge</p>
        <h2 id="charge">Your strategy stays yours.</h2>
      </div>
      <div class="grid">
        <div class="card">
          <h3>Nothing goes out without your yes</h3>
          <p>You approve every post, every ad and every dollar. CMO Kit never invents a quote, a result or a deadline.</p>
        </div>
        <div class="card">
          <h3>Yours to keep</h3>
          <p>Your brand strategy, and everything CMO Kit learns about what works for you, belong to you. Export it or take it with you any time.</p>
        </div>
        <div class="card">
          <h3>Your content, your voice</h3>
          <p>CMO Kit plans around your own footage and words, not templates.</p>
        </div>
        <div class="card">
          <h3>Open source</h3>
          <p>Anyone can read the code or run it themselves.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="why">
    <div class="container why">
      <p class="eyebrow" id="why">Why we built it</p>
      <blockquote>AI lets anyone make and optimize endless content, your competitors included. What stands out is what AI can't commoditize: your humanity.</blockquote>
      <p class="lead">So CMO Kit plans your content, measures and analyzes the results, and recommends improvements, so you have more room for the creative work only you can do.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="ready">
    <div class="container closing">
      <h2 id="ready">Less busywork. More room to create.</h2>
      <p class="lead">The closed beta opens a few people at a time.</p>
      <a class="button button--primary" href="#join">Join the waitlist</a>
    </div>
  </section>

  <script is:inline>
  // Counts this page as a visit for the brand's funnel, once a session; it sends no cookie and no identity.
  try {
    const seen = 'cmokit-visit:' + location.pathname;
    if (!sessionStorage.getItem(seen)) {
      sessionStorage.setItem(seen, '1');
      fetch('https://app.cmokit.ai/join/c0f559a8489d8735', { method: 'POST', mode: 'no-cors', credentials: 'omit', keepalive: true, body: new URLSearchParams({ visit: '1', page: location.href }) });
    }
  } catch {}
  document.querySelectorAll('[data-cmokit-waitlist]').forEach((box) => {
    const join = box.querySelector('[data-cmokit-join]');
    join.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = new URLSearchParams(new FormData(join));
      body.set('page', location.href);
      body.set('ref', new URLSearchParams(location.search).get('ref') || '');
      const response = await fetch(join.action, { method: 'POST', body, headers: { accept: 'application/json' } });
      const answer = await response.json().catch(() => ({}));
      if (!answer.referral) return alert(answer.problem || 'That did not work. Try again.');
      const link = box.querySelector('[data-cmokit-referral]');
      link.href = link.textContent = answer.referral;
      if (answer.place) box.querySelector('[data-cmokit-place]').textContent = "You're number " + answer.place + ' on the list.';
      join.hidden = true;
      box.querySelector('[data-cmokit-joined]').hidden = false;
      if (answer.instagram) {
        box.querySelector('[data-cmokit-code]').textContent = answer.instagram.code;
        const account = box.querySelector('[data-cmokit-account]');
        account.href = 'https://www.instagram.com/' + encodeURIComponent(answer.instagram.account) + '/';
        account.textContent = '@' + answer.instagram.account + ' on Instagram';
        box.querySelector('[data-cmokit-instagram]').hidden = false;
      }
      box.dispatchEvent(new CustomEvent('cmokit:joined', { bubbles: true, detail: { referral: answer.referral, place: answer.place ?? null } }));
    });
  });
  </script>

  <script is:inline>
  // The copy blocks for the referral link and the Instagram code. They only read what the script
  // above fills in.
  document.querySelectorAll('[data-copy]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      const target = button.closest('.referral').querySelector(button.dataset.copy);
      try {
        await navigator.clipboard.writeText(target.href || target.textContent);
        button.textContent = 'Copied';
      } catch {
        getSelection().selectAllChildren(target);
        button.textContent = 'Press Ctrl+C or ⌘C';
      }
      setTimeout(() => { button.textContent = label; }, 2500);
    });
  });
  </script>
</Page>
